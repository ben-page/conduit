<Project>

  <!-- The samples build under the repository's settings (analyzers, warnings as errors, language version), so they are
       held to the same standard as the libraries they demonstrate. -->
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A sample names its own package versions, as a project copied out of the repository would. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
