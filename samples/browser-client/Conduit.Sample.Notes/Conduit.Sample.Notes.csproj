<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS9057;IDE0005</NoWarn>
    <ConduitTypeGenEnabled>true</ConduitTypeGenEnabled>
    <ConduitTypeGenTaskAssembly>$(MSBuildProjectDirectory)\..\..\..\src\Conduit.TypeGen\bin\Debug\net10.0\Conduit.TypeGen.dll</ConduitTypeGenTaskAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Conduit\Conduit.csproj" />
    <ProjectReference Include="..\..\..\src\Conduit.Transport.Http\Conduit.Transport.Http.csproj" />
    <ProjectReference Include="..\..\..\src\Conduit.Transport.SignalR\Conduit.Transport.SignalR.csproj" />
    <ProjectReference Include="..\..\..\src\Conduit.SourceGen\Conduit.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\src\Conduit.Analysis\Conduit.Analysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\..\src\Conduit.TypeGen\Conduit.TypeGen.targets" />

  <Target Name="BuildClientApp" AfterTargets="ConduitTypeGen">
    <PropertyGroup>
      <ClientAppDir>$(MSBuildProjectDirectory)\ClientApp</ClientAppDir>
    </PropertyGroup>
    <Exec Command="npm install" WorkingDirectory="$(ClientAppDir)" Condition="!Exists('$(ClientAppDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppDir)" />
  </Target>

</Project>
