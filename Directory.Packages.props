    <!-- Floors, not stale pins: the source generators and TypeGen's MSBuild task load inside each CONSUMER's compiler
         and MSBuild, so these name the oldest toolchain a consumer may build with. Raising Microsoft.CodeAnalysis.* past
         a consumer's SDK compiler stops the generator loading there (CS9057); move them only with every consumer's SDK. -->
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.4.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
