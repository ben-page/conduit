<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\transport-ts\emitted\*.ts" Link="emitted\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Conduit\Conduit.csproj" />
    <ProjectReference Include="..\..\src\Conduit.TypeGen\Conduit.TypeGen.csproj" />
    <!-- Named here because Conduit.TypeGen references it privately; the tests build its type model by hand. -->
    <ProjectReference Include="..\..\src\Conduit.Analysis\Conduit.Analysis.csproj" />
    <!-- Built and copied next to the tests, never referenced: it declares its own Conduit.Messages.IQuery<T>, which would
         collide with Conduit.Contracts' at compile time. The tests load it by path into a MetadataLoadContext. -->
    <ProjectReference Include="..\Conduit.TypeGen.Tests.NetStandardContracts\Conduit.TypeGen.Tests.NetStandardContracts.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
