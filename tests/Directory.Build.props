<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <!-- MSTest runs on Microsoft.Testing.Platform (global.json selects it for dotnet test). -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <!-- JUnit XML logger so every test project emits {assembly}.junit.xml (into
       ./TestResults/ when run from the root) that the CI workflow
       (.github/workflows/ci.yml) uploads as a run artifact. Declared
       once here; no per-project PackageReference needed. -->
  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" />
  </ItemGroup>

</Project>
