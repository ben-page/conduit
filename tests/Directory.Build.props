<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- JUnit XML logger so every test project emits test-results.xml that
       GitLab can surface in the MR UI via `reports: junit:`. Declared once
       here; no per-project PackageReference needed. -->
  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" />
  </ItemGroup>

</Project>
