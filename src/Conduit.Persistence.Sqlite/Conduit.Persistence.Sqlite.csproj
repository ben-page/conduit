<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQLite engine for Conduit persistence: stores the outbox, inbox, dead-letter queue, audit trail and jobs in SQLite.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conduit.Durability.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit\Conduit.csproj" />
    <ProjectReference Include="..\Conduit.Persistence\Conduit.Persistence.csproj" />
  </ItemGroup>

</Project>
