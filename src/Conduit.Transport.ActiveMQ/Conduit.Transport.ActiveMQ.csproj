<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ActiveMQ Artemis transport for Conduit: routes commands and queries and broadcasts events through Artemis addresses and queues over AMQP 1.0.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conduit.Transport.ActiveMQ.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AMQPNetLite.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit\Conduit.csproj" />
  </ItemGroup>

</Project>
