<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Background jobs for Conduit: cron and interval schedules and event triggers that run commands, once across the cluster when a Conduit persistence engine is registered.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Conduit.Jobs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Conduit\Conduit.csproj" />
    <ProjectReference Include="..\Conduit.Persistence\Conduit.Persistence.csproj" />
  </ItemGroup>
</Project>
