<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core runtime of Conduit, a source-generated mediator for .NET: message and handler interfaces, endpoint routing, the dispatch pipeline and configuration.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Memory.Data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Contracts\Conduit.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conduit.Tests" />
    <InternalsVisibleTo Include="Conduit.Resilience.Tests" />
  </ItemGroup>

</Project>
