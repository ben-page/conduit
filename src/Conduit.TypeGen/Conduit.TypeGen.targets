<Project>
  <PropertyGroup>
    <ConduitTypeGenOutput Condition="'$(ConduitTypeGenOutput)' == ''">ClientApp/generated</ConduitTypeGenOutput>
    <ConduitTransports Condition="'$(ConduitTransports)' == ''">Http;SignalR</ConduitTransports>
    <ConduitBasePath Condition="'$(ConduitBasePath)' == ''">/api/conduit</ConduitBasePath>
    <ConduitHubPath Condition="'$(ConduitHubPath)' == ''">/conduit</ConduitHubPath>
    <!-- Consumers can point TypeGen at a different assembly (e.g. a referenced
         project that actually contains the [ClientVisible] types). Defaults to
         this project's own build output. -->
    <ConduitTypeGenAssemblyPath Condition="'$(ConduitTypeGenAssemblyPath)' == ''">$(TargetPath)</ConduitTypeGenAssemblyPath>
  </PropertyGroup>

  <UsingTask TaskName="Conduit.TypeGen.TypeGenTask"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\Conduit.TypeGen.dll" />

  <Target Name="ConduitTypeGen" AfterTargets="Build"
          Condition="'$(ConduitTypeGenEnabled)' == 'true'">
    <TypeGenTask
      AssemblyPath="$(ConduitTypeGenAssemblyPath)"
      OutputDirectory="$(ConduitTypeGenOutput)"
      Transports="$(ConduitTransports)"
      BasePath="$(ConduitBasePath)"
      HubPath="$(ConduitHubPath)" />
  </Target>
</Project>
