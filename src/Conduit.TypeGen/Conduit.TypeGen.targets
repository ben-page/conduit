<Project>
  <PropertyGroup>
    <ConduitTypeGenOutput Condition="'$(ConduitTypeGenOutput)' == ''">ClientApp/generated</ConduitTypeGenOutput>
    <ConduitTransports Condition="'$(ConduitTransports)' == ''">Http;SignalR</ConduitTransports>
    <ConduitBasePath Condition="'$(ConduitBasePath)' == ''">/api/conduit</ConduitBasePath>
    <ConduitHubPath Condition="'$(ConduitHubPath)' == ''">/conduit</ConduitHubPath>
  </PropertyGroup>

  <!-- NuGet package layout: task DLL lives under tasks/net10.0/ next to the
       targets file's parent. The task targets net10.0, so it loads only in the
       dotnet CLI's MSBuild, never in Visual Studio's .NET Framework msbuild.exe. -->
  <UsingTask TaskName="Conduit.TypeGen.TypeGenTask"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\Conduit.TypeGen.dll"
             Condition="'$(ConduitTypeGenTaskAssembly)' == ''" />

  <!-- Project-reference layout (in-repo samples + tests): consumer sets
       ConduitTypeGenTaskAssembly to the built DLL path. -->
  <UsingTask TaskName="Conduit.TypeGen.TypeGenTask"
             AssemblyFile="$(ConduitTypeGenTaskAssembly)"
             Condition="'$(ConduitTypeGenTaskAssembly)' != ''" />

  <!-- Runs after every build, and is incremental by content rather than by Inputs/Outputs: the task writes a file only
       when its content changed, so a build that changed nothing leaves both files and their timestamps alone. A
       timestamp check could not see a change to the task itself (conduit.ts is its embedded transport) or to
       ConduitTransports, ConduitBasePath or ConduitHubPath. -->
  <Target Name="ConduitTypeGen" AfterTargets="Build"
          Condition="'$(ConduitTypeGenEnabled)' == 'true'">
    <!-- Defaulted inside the target so $(TargetPath) is fully resolved (it's
         populated by SDK targets during build, not at evaluation time). -->
    <PropertyGroup>
      <ConduitTypeGenAssemblyPath Condition="'$(ConduitTypeGenAssemblyPath)' == ''">$(TargetPath)</ConduitTypeGenAssemblyPath>
    </PropertyGroup>
    <!-- Both paths absolute, a relative one anchored to the project directory: the task would resolve it against the
         process's working directory, which is wherever the build was started from. -->
    <TypeGenTask
      AssemblyPath="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ConduitTypeGenAssemblyPath)'))"
      OutputDirectory="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ConduitTypeGenOutput)'))"
      Transports="$(ConduitTransports)"
      BasePath="$(ConduitBasePath)"
      HubPath="$(ConduitHubPath)" />
  </Target>
</Project>
