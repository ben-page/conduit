<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pack as an MSBuild task package: task DLL + non-MSBuild deps under
         tasks/, targets under build/. SuppressDependenciesWhenPacking keeps
         these dependencies out of the published nuspec so NuGet consumers
         don't pull MSBuild/MetadataLoadContext transitively — the host
         MSBuild process already provides Microsoft.Build.*, and
         MetadataLoadContext is bundled into tasks/ alongside the task DLL.
         Project-reference consumers (e.g. Conduit.TypeGen.Tests) still see
         these via normal MSBuild project flow. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- NU5100: we intentionally ship the task DLL outside lib/ (it's an
         MSBuild task, not a runtime reference). -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Build.* is provided by the hosting MSBuild process at task
         execution time. We let runtime assets flow normally so test projects
         that consume TypeGen via ProjectReference can load the framework
         types — the published nupkg uses explicit None Includes (not globs),
         so Microsoft.Build.* doesn't end up packaged regardless. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Analysis\Conduit.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- So Conduit.TypeGen.Tests can unit-test MergeFileEmitter.ThrowIfErrorTypeNameCollides directly: a real
         name collision can only be constructed with two same-short-named types, and adding those permanently
         to the shared test assembly would trip the guard for every OTHER test that scans it (see that
         method's doc comment). -->
    <InternalsVisibleTo Include="Conduit.TypeGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The TS transport's source: real TypeScript, run by tests/transport-ts, assembled into conduit.ts by
         BaseFileEmitter through TransportSource. Inside the task DLL, so the NuGet layout is unchanged. -->
    <EmbeddedResource Include="Transport\*.ts" LogicalName="Conduit.TypeGen.Transport.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Bundle everything the task needs at runtime into tasks/net10.0/. -->
  <ItemGroup>
    <None Include="$(OutputPath)\Conduit.TypeGen.dll" Pack="true" PackagePath="tasks/net10.0" Visible="false" />
    <None Include="$(OutputPath)\Conduit.Analysis.dll" Pack="true" PackagePath="tasks/net10.0" Visible="false" />
    <None Include="$(OutputPath)\System.Reflection.MetadataLoadContext.dll" Pack="true" PackagePath="tasks/net10.0" Visible="false" />
    <None Include="Conduit.TypeGen.targets" Pack="true" PackagePath="build" Visible="false" />
  </ItemGroup>

</Project>
