<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Audit trail for Conduit: records the lifecycle of every dispatch and stores it in batches through a Conduit persistence engine.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conduit.Audit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit\Conduit.csproj" />
    <ProjectReference Include="..\Conduit.Persistence\Conduit.Persistence.csproj" />
  </ItemGroup>

</Project>
